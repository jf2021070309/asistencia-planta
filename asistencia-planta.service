[Unit]
Description=SURGAS - Asistencia Planta (Node.js Service)
After=network.target mariadb.service mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/asistencia-planta
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

# Seguridad básica
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

